# ──────────────────────────────────────────
# Domain Configuration
# ──────────────────────────────────────────
LIVEKIT_DOMAIN=livekit.yourdomain.com

# ──────────────────────────────────────────
# LiveKit Credentials
# Generate: openssl rand -hex 32
# Must match keys in livekit.yaml!
# ──────────────────────────────────────────
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-change-me-in-production

# ──────────────────────────────────────────
# AI Provider API Keys
# Set only the ones you use
# ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...
ELEVEN_API_KEY=...

# ──────────────────────────────────────────
# Agent Config (optional)
# ──────────────────────────────────────────
AGENT_CONFIG=configs/default.yaml
