# Caddy reverse proxy with automatic SSL
# Replace {$LIVEKIT_DOMAIN} with your actual domain or set as env var

# LiveKit WebSocket & API
{$LIVEKIT_DOMAIN} {
    reverse_proxy localhost:7880
}

# Frontend
app.{$LIVEKIT_DOMAIN} {
    reverse_proxy localhost:3000
}

# TURN TLS (optional, for firewall traversal)
turn.{$LIVEKIT_DOMAIN} {
    reverse_proxy localhost:5349
}
