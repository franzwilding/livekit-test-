# LiveKit credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Model provider API keys (set the ones you use)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...
ELEVEN_API_KEY=...

# Agent config file path (optional, defaults to configs/default.yaml)
AGENT_CONFIG=configs/default.yaml
